# Keep the image clean AND private. config/ is excluded so personal config can
# never be baked into a published image (mount it at runtime instead).
config/
.git/
.github/
.venv/
venv/
tests/
docs/
examples/
bot-state/
*.local.*
*.pem
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
*.log
.DS_Store
